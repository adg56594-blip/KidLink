# python manage.py generate_keys
KIDLINK_FIELD_KEYS=
KIDLINK_SIGNING_KEY=

POSTGRES_DB=kidlink
POSTGRES_USER=kidlink
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
